---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title?: string;
}
const { title } = Astro.props;
---

<BaseLayout title={title}>
  <slot />
  <noscript>
    <p style="padding:2rem;text-align:center;font-size:1.25rem">MindMate needs JavaScript turned on.</p>
  </noscript>
</BaseLayout>
